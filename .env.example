# Copy to .env and fill in. Never commit .env.
#
# Per-API vars:  NITRO_<APINAME>_<VAR>   ->   process.env.<VAR>, only inside routes/<apiname>/
# Everything else (PORT, STORAGE_DIR, FILES_DRIVER, S3_*) is global and passes through.

# ---------------------------------------------------------------- global
PORT=3000
# HOST_PORT=3000            # docker-compose only: port on the host
# STORAGE_DIR=./storage     # root for storage/<apiname>/{db.sqlite,kv/,files/}
# FILES_DRIVER=fs           # fs (default) or s3
# ROUTES_DIR=./local-routes # folder of mounted APIs (docker-compose sets /app/local-routes itself)

# ---------------------------------------------------------------- weather
NITRO_WEATHER_API_KEY=change-me
NITRO_WEATHER_UNITS=metric
# Leave unset to use SQLite at storage/weather/db.sqlite:
# NITRO_WEATHER_DATABASE_URL=postgres://user:password@localhost:5432/weather
# NITRO_WEATHER_DATABASE_URL=mysql://user:password@localhost:3306/weather

# ---------------------------------------------------------------- hello
NITRO_HELLO_GREETING=Hello

# ---------------------------------------------------------------- notes
# NITRO_NOTES_DATABASE_URL=postgres://user:password@localhost:5432/notes

# ---------------------------------------------------------------- S3 file storage
# Used when FILES_DRIVER=s3. Works with AWS S3, Cloudflare R2, MinIO, etc.
# Files are stored as <bucket>/<apiname>/<name>.
# FILES_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com    # R2: https://<account>.r2.cloudflarestorage.com
# S3_REGION=eu-central-1                               # R2: auto
# S3_BUCKET=plof-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
